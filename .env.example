# ==============================================================================
# 1. CREDENCIALES OAUTH 2.0 DE LINKEDIN (Para Fase 2 / Publicación vía API)
# ==============================================================================
# Copia este archivo como '.env' en la raíz del proyecto (NUNCA se sube a GitHub).
# Crea tu aplicación en: https://www.linkedin.com/developers/apps

LINKEDIN_CLIENT_ID=tu_client_id_aqui
LINKEDIN_CLIENT_SECRET=tu_client_secret_aqui
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Scopes requeridos en LinkedIn Developer Portal:
# - Sign In with LinkedIn using OpenID Connect: openid, profile, email
# - Share on LinkedIn: w_member_social
LINKEDIN_SCOPES=openid,profile,w_member_social

# Versión de la API REST de LinkedIn (Formato YYYYMM)
LINKEDIN_API_VERSION=202610

# ==============================================================================
# 2. CONFIGURACIÓN LOCAL DEL USUARIO Y REPOSITORIOS
# ==============================================================================
# Ruta local donde almacenas tus proyectos de código para que el agente los
# inspeccione y ejecute en vivo al tomar capturas de pantalla:
LOCAL_REPOS_DIR=C:/ruta/a/tus/repositorios
